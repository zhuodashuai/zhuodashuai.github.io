{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zhuo-wordbook-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "../vocab",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "PUBLIC_SITE_URL": "https://zhuodashuai.github.io/vocab/",
    "GITHUB_OWNER": "zhuodashuai",
    "GITHUB_OWNER_ID": "156042078",
    "GITHUB_REPOSITORY": "zhuodashuai.github.io",
    "GITHUB_REPOSITORY_ID": "1309360291",
    "GITHUB_BRANCH": "main",
    "GITHUB_WORDBOOK_PATH": "vocab/data/owner-wordbook.json",
    "AI_PROVIDER": "openai",
    "AI_FALLBACK_PROVIDER": "anthropic",
    "OPENAI_MODEL": "gpt-5.6-terra"
  },
  "durable_objects": {
    "bindings": [
      { "name": "OWNER_CONTROL", "class_name": "OwnerControl" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OwnerControl"]
    }
  ]
}
