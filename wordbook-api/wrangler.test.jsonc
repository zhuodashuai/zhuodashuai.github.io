{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zhuo-wordbook-api-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../vocab",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "MEMBER_SIGNUP_ENABLED": "true",
    "PUBLIC_SITE_URL": "https://zhuodashuai.github.io/vocab/",
    "GITHUB_OWNER": "zhuodashuai",
    "GITHUB_OWNER_ID": "156042078",
    "GITHUB_REPOSITORY": "zhuodashuai.github.io",
    "GITHUB_REPOSITORY_ID": "1309360291",
    "GITHUB_BRANCH": "main",
    "GITHUB_WORDBOOK_PATH": "vocab/data/owner-wordbook.json",
    "AI_PROVIDER": "openai",
    "OPENAI_MODEL": "gpt-5.6-terra"
  },
  "durable_objects": {
    "bindings": [
      { "name": "OWNER_CONTROL", "class_name": "OwnerControl" },
      { "name": "MEMBER_AUTH", "class_name": "MemberAuth" },
      { "name": "PERSONAL_WORDBOOK", "class_name": "PersonalWordbook" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OwnerControl"]
    },
    {
      "tag": "v2-member-wordbooks",
      "new_sqlite_classes": ["MemberAuth", "PersonalWordbook"]
    }
  ]
}
