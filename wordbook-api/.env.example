# Never put real values in this file. Configure these as Cloudflare secrets.
GITHUB_APP_CLIENT_ID=replace_with_github_app_client_id
GITHUB_APP_CLIENT_SECRET=replace_with_github_app_client_secret
SESSION_SECRET=replace_with_32_random_bytes_encoded_as_base64url

# The default Cloudflare Workers AI binding needs no API key. The paid
# provider below is optional and must never be enabled as a fallback unless
# ALLOW_PAID_AI_FALLBACK=true is also set deliberately in Worker variables.
# Cloudflare model names are non-secret Worker variables. The primary, retry
# and rescue models are pinned in wrangler.jsonc and share account allocation.
OPENAI_API_KEY=optional_paid_openai_project_api_key
OPENAI_MODEL=optional_paid_openai_model
