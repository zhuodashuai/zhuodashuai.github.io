# Never put real values in this file. Configure these as Cloudflare secrets.
GITHUB_APP_CLIENT_ID=replace_with_github_app_client_id
GITHUB_APP_CLIENT_SECRET=replace_with_github_app_client_secret
SESSION_SECRET=replace_with_32_random_bytes_encoded_as_base64url
OPENAI_API_KEY=replace_with_openai_project_api_key

# Optional Claude fallback. Keep AI_PROVIDER=openai and set
# AI_FALLBACK_PROVIDER=anthropic in Worker variables, or reverse the order.
ANTHROPIC_API_KEY=replace_with_anthropic_api_key
ANTHROPIC_MODEL=replace_with_current_stable_anthropic_model
