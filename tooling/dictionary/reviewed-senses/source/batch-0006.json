    {
      "term": "garnish",
      "partOfSpeech": "verb",
      "meaning": "① 依法扣划工资或账户款项等，用于偿还债务等；常见于美式法律语境。",
      "chineseAliases": [
        "依法扣工资",
        "依法扣划工资",
        "依法扣划账户款项"
      ],
      "englishForms": [
        "garnished",
        "garnishes",
        "garnishing"
      ],
      "en": "The notice said that part of his wages would be garnished to repay the debt.",
      "zh": "通知说，他的一部分工资将被依法扣划，用于偿还债务。",
      "references": [
        "https://www.merriam-webster.com/dictionary/garnish",
        "https://dictionary.cambridge.org/dictionary/english/garnish"
      ],
      "canonicalId": 884731,
      "canonicalSourceSha256": "8ff6fc4c372201c6b32a36765fa6db1fc404da4772d2415c3992aea0b1bf8998"
    },
    {
      "term": "grand",
      "partOfSpeech": "noun",
      "meaning": "① 一千美元或一千英镑，口语用法；具体币种看语境。表示这种金额的复数通常仍用 grand。",
      "chineseAliases": [
        "一千美元",
        "一千英镑",
        "口语中的一千美元"
      ],
      "englishForms": [],
      "en": "Priced at US$4,000, the used van was one grand over our budget.",
      "zh": "这辆二手面包车售价四千美元，比我们的预算高出一千美元。",
      "references": [
        "https://www.collinsdictionary.com/us/dictionary/english/grand"
      ],
      "canonicalId": 181053,
      "canonicalSourceSha256": "39958c121bff39b0fa6bb1fc6a3b83d550bb6d4f9998fbeffd755e807dbfe081"
    },
    {
      "term": "dedicated",
      "partOfSpeech": "adjective",
      "meaning": "① 专用的；为某一特定用途而专门设置、分配或留出的。",
      "chineseAliases": [
        "专用的",
        "为特定用途留出的",
        "为特定用途专门设置的"
      ],
      "englishForms": [],
      "en": "She keeps a dedicated notebook for words she hears on the bus.",
      "zh": "她备有一本专用笔记本，记录在公交车上听到的词。",
      "references": [
        "https://www.collinsdictionary.com/dictionary/english/dedicated",
        "https://dictionary.cambridge.org/dictionary/english/dedicated"
      ],
      "canonicalId": 9334210,
      "canonicalSourceSha256": "3943bd09769de008c71447ca4d9035648d29ebebcf24cbc3d345c5b6320fad7e"
    },
    {
      "term": "substantially",
      "partOfSpeech": "adverb",
      "meaning": "① 大幅地；在很大程度上。常描述数量、金额或程度上的明显差异或变化。",
      "chineseAliases": [
        "大幅地",
        "在很大程度上"
      ],
      "englishForms": [],
      "en": "After he moved closer to work, his monthly travel costs were substantially lower.",
      "zh": "搬到离工作地点更近的地方后，他每月的交通支出大幅降低。",
      "references": [
        "https://www.collinsdictionary.com/dictionary/english/substantially",
        "https://dictionary.cambridge.org/us/dictionary/english/substantially",
        "https://www.dictionary.com/browse/substantially"
      ],
      "canonicalId": 468540,
      "canonicalSourceSha256": "0010fe705181b0fe611b10e34b857187b6dd559a80c8cbff0efe3902d6558ca6"
    },
    {
      "term": "precipitous",
      "partOfSpeech": "adjective",
      "meaning": "① 骤然的；急剧的，常形容下降或突发的不利变化。例如 a precipitous decline 表示急剧下降。",
      "chineseAliases": [
        "急剧的",
        "骤然的",
        "急剧变化的"
      ],
      "englishForms": [],
      "en": "The shop suffered a precipitous decline in sales after the bridge closed.",
      "zh": "桥梁封闭后，这家商店的销售额急剧下降。",
      "references": [
        "https://www.collinsdictionary.com/us/dictionary/english/precipitous"
      ],
      "canonicalId": 1133000,
      "canonicalSourceSha256": "4b15b8855e288671e6d2405f506367fc8ec2e5affb254bb20208b626bc688e65"
    },
    {
      "term": "mandate",
      "partOfSpeech": "verb",
      "meaning": "① 强制要求；正式规定必须做某事。可用于法律、法院或有权机构作出的要求。",
      "chineseAliases": [
        "强制要求",
        "正式强制规定",
        "法院强制规定"
      ],
      "englishForms": [
        "mandated",
        "mandates",
        "mandating"
      ],
      "en": "The court mandated a review of the company's payment records.",
      "zh": "法院强制要求审查这家公司的付款记录。",
      "references": [
        "https://www.ahdictionary.com/word/search.html?q=mandate",
        "https://www.collinsdictionary.com/us/dictionary/english/mandate"
      ],
      "canonicalId": 1197355,
      "canonicalSourceSha256": "6bdcafcd9534b0f4720488905c14d511e653d6ff476ae4426209c81a4ddc5731"
    },
    {
      "term": "at fault",
      "partOfSpeech": "adjective phrase",
      "meaning": "① 有过错；对某种错误或不良结果负有责任。",
      "chineseAliases": [
        "有过错",
        "对错误负有责任"
      ],
      "englishForms": [],
      "en": "I was at fault for sending the invitations to the wrong address.",
      "zh": "邀请函寄错地址是我的过错。",
      "references": [
        "https://www.collinsdictionary.com/dictionary/english/at-fault"
      ],
      "canonicalId": 9052908,
      "canonicalSourceSha256": "351f2841180a8e877afb1fcbfcc6ed5cb98af96f2083333175b230cb62b73cf7"
    },
    {
      "term": "provision",
      "partOfSpeech": "noun (uncountable)",
      "meaning": "① 提供；供应，指把所需的物品、服务或保障提供给他人的行为或过程。常用 the provision of something。",
      "chineseAliases": [
        "提供服务的行为",
        "保障的提供",
        "物品或服务的供应"
      ],
      "englishForms": [],
      "en": "The council's plan includes the provision of hot meals to older residents.",
      "zh": "市政委员会的计划包括为年长居民提供热饭。",
      "references": [
        "https://www.collinsdictionary.com/dictionary/english/provision"
      ],
      "canonicalId": 199616,
      "canonicalSourceSha256": "9069eb8846b0274ee28d93d437ccce1bce23b540d7ade85143d112f80d6b12c8"
    },
    {
      "term": "alumni",
      "partOfSpeech": "noun (plural)",
      "meaning": "① 校友；曾在某所学校就读的人们，使用复数形式。可指男性校友群体，也常用于不同性别组成的校友群体；不只限于男性。",
      "chineseAliases": [
        "校友群体",
        "不同性别的校友"
      ],
      "englishForms": [],
      "en": "Alumni from several generations returned to the college for the exhibition.",
      "zh": "多届校友回到学院参观展览。",
      "references": [
        "https://editorial-styleguide.strategiccommunication.wisc.edu/term/alumn/",
        "https://www.dictionary.com/browse/alumni"
      ],
      "canonicalId": 3699875,
      "canonicalSourceSha256": "4a0bb26830400553bc70486cbf46f6b49cb490ce1dd920426cb617db137a854c"
    },
    {
      "term": "default",
      "partOfSpeech": "noun",
      "meaning": "① 默认安排；未另外作出选择或约定时，通常会采用的选项、做法或状态。",
      "chineseAliases": [
        "默认安排",
        "未另作选择时的安排"
      ],
      "englishForms": [],
      "en": "A shared desk is the default unless a separate room has been agreed in advance.",
      "zh": "除非事先约定使用单独的房间，否则默认安排是共用一张办公桌。",
      "references": [
        "https://www.collinsdictionary.com/us/dictionary/english/default"
      ],
      "canonicalId": 581982,
      "canonicalSourceSha256": "771d9a8f1091ee5f0a1b1eedcc8b46d83644107cf3d1f679efa608d4a168dfdc"
    },
    {
      "term": "bargain for",
      "partOfSpeech": "verb phrase",
      "meaning": "① 通过协商争取某物或某种条件；for 后接希望争取到的东西。这里是 bargain 的协商义，不是 bargain for/on 表示“预料到”的用法。",
      "chineseAliases": [
        "通过协商争取",
        "谈判争取某种条件"
      ],
      "englishForms": [
        "bargained for",
        "bargains for",
        "bargaining for"
      ],
      "en": "The tenants bargained for a longer notice period before signing the agreement.",
      "zh": "租户们在签署协议前，通过协商争取更长的提前通知期。",
      "references": [
        "https://dictionary.cambridge.org/us/dictionary/english/bargain",
        "https://www.collinsdictionary.com/dictionary/english/bargain"
      ],
      "canonicalId": 9082578,
      "canonicalSourceSha256": "a17c2085f5f18e29a5ef26bf038d66b45ddf45646773e7aa17888c12dc723cff"
    },
    {
      "term": "strike it rich",
      "partOfSpeech": "idiom",
      "meaning": "① 发大财；突然获得大量金钱或取得意外的财务成功，常用于非正式语境。",
      "chineseAliases": [
        "发大财",
        "突然发财",
        "意外获得财务成功"
      ],
      "englishForms": [
        "struck it rich",
        "strikes it rich",
        "striking it rich"
      ],
      "en": "He hoped to strike it rich when he launched his first mobile game.",
      "zh": "他推出第一款手机游戏时，希望借此发大财。",
      "references": [
        "https://www.collinsdictionary.com/dictionary/english/strike-it-rich"
      ],
      "canonicalId": 10344334,
      "canonicalSourceSha256": "731539ab88ccda0e437ebdb57353b9f45091238a04a215360c74e8e03f048515"
    }
