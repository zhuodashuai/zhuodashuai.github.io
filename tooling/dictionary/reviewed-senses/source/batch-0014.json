  "entries": [
    {
      "term": "scary",
      "partOfSpeech": "adjective",
      "meaning": "① 吓人的；使人害怕的，非正式用语，可形容地方、故事、经历或前景。\n② 容易受惊的；胆小的，形容容易感到害怕的人或动物。\n③ 感到害怕的；提心吊胆的，表示自身处于害怕的状态。",
      "chineseAliases": [
        "吓人的",
        "使人害怕的"
      ],
      "englishForms": [
        "scarier",
        "scariest"
      ],
      "en": "The tunnel looked scary until we saw daylight ahead.",
      "zh": "在我们看见前方的日光之前，那条隧道一直显得很吓人。",
      "references": [
        "https://www.oxfordlearnersdictionaries.com/definition/english/scary",
        "https://www.merriam-webster.com/dictionary/scary"
      ],
      "canonicalId": 1850127,
      "canonicalSourceSha256": "0d30af281ff11be428fbc521c42cb4567c7474ebfdb78f40b90076db46b7c75a"
    },
    {
      "term": "downside",
      "partOfSpeech": "noun",
      "meaning": "① 不利的一面；缺点，常用 downside of something 表示某事物的不足之处。\n② 下降趋势，例如价格等向下变动的趋势。",
      "chineseAliases": [
        "不利的一面",
        "不足之处"
      ],
      "englishForms": [
        "downsides"
      ],
      "en": "The downside of the beautiful attic was its low ceiling.",
      "zh": "那间漂亮阁楼的缺点是天花板低。",
      "references": [
        "https://www.oxfordlearnersdictionaries.com/definition/english/downside",
        "https://www.merriam-webster.com/dictionary/downside"
      ],
      "canonicalId": 1903374,
      "canonicalSourceSha256": "d6cfc1d5b4fb79a301eccf97fc3f098ce86f387ac4759e2aa10809c00eed9cc8"
    },
    {
      "term": "loo",
      "partOfSpeech": "noun",
      "meaning": "① 厕所；洗手间，英式非正式用语，复数为 loos。\n② 卢牌戏，一种纸牌游戏，与厕所义分开理解。",
      "chineseAliases": [
        "厕所",
        "英式洗手间"
      ],
      "englishForms": [
        "loos"
      ],
      "en": "The loo is upstairs beside the small storage room.",
      "zh": "厕所在楼上，挨着小储藏室。",
      "references": [
        "https://www.oxfordlearnersdictionaries.com/definition/english/loo",
        "https://www.merriam-webster.com/dictionary/loo"
      ],
      "canonicalId": 1907513,
      "canonicalSourceSha256": "0c7a8a3f662273826c8180ea19290c30b4cb36f54df319cc563ca568ae05a087"
    },
    {
      "term": "perk",
      "partOfSpeech": "noun · verb",
      "meaning": "① 名词：工作附带的额外福利或好处，通常在工资之外，常用复数 perks。\n② 名词：某种身份、处境或活动附带的额外好处，不限于工作待遇。\n③ 动词：振作起来；恢复精神，通常用 perk up。\n④ 动词：昂首、伸颈；神气地挺起身体，或使某物迅速竖起。\n⑤ 动词：使外表更精神、好看，常用 perk something up。",
      "chineseAliases": [
        "额外福利",
        "附带的好处"
      ],
      "englishForms": [
        "perked",
        "perking",
        "perks"
      ],
      "en": "Free concert tickets were a welcome perk of the job.",
      "zh": "免费的音乐会票是这份工作令人欣喜的额外福利。",
      "references": [
        "https://www.oxfordlearnersdictionaries.com/definition/english/perk_1",
        "https://www.merriam-webster.com/dictionary/perk",
        "https://www.oxfordlearnersdictionaries.com/definition/english/perk_2"
      ],
      "canonicalId": 1927005,
      "canonicalSourceSha256": "29f26b9564c5e4732e4624347d733327d14f38fa0b46ac2a89533879fdff1d01"
    },
    {
      "term": "derail",
      "partOfSpeech": "verb",
      "meaning": "① 使计划、项目或进程受阻；使其偏离预定方向，比喻用法。\n② 使列车脱轨；列车脱轨，可作及物或不及物动词。",
      "chineseAliases": [
        "使计划受阻",
        "扰乱进程"
      ],
      "englishForms": [
        "derailed",
        "derailing",
        "derails"
      ],
      "en": "A missing permit threatened to derail the renovation.",
      "zh": "缺少许可证可能使翻修计划受挫。",
      "references": [
        "https://www.oxfordlearnersdictionaries.com/definition/english/derail"
      ],
      "canonicalId": 1953270,
      "canonicalSourceSha256": "d0cbd434203933340b0801457ee8f26bcac6188482820272f7a0fa096ad7aa47"
    },
    {
      "term": "unwind",
      "partOfSpeech": "verb",
      "meaning": "① 放松下来；缓解紧张，指人从忙碌、压力或紧绷的状态中放松，作不及物动词。\n② 展开、解开卷绕着的东西；使其松开，也可指卷绕物自行松开，可作及物或不及物动词。",
      "chineseAliases": [
        "放松身心",
        "缓解紧张"
      ],
      "englishForms": [
        "unwinding",
        "unwinds"
      ],
      "en": "She unwound by sketching the view from her window.",
      "zh": "她画窗外的景色来放松。",
      "references": [
        "https://www.oxfordlearnersdictionaries.com/definition/english/unwind"
      ],
      "canonicalId": 2037224,
      "canonicalSourceSha256": "7114731fe3306a3dc222439bb37dff3921cb39a9e434b1457a516a0ce9fc3445"
    },
    {
      "term": "binge",
      "partOfSpeech": "noun · verb",
      "meaning": "① 名词：一阵无节制、过量的活动，尤其常说暴食或酗酒，也可指一口气大量从事其他活动。\n② 不及物动词：暴食；狂饮，常用 binge on something，指吃喝过量，往往难以自制。",
      "chineseAliases": [
        "一阵无节制的活动",
        "暴食狂饮"
      ],
      "englishForms": [
        "binged",
        "bingeing",
        "binges"
      ],
      "en": "A reading binge kept her indoors all weekend.",
      "zh": "她一阵猛读，整个周末都待在屋里。",
      "references": [
        "https://www.oxfordlearnersdictionaries.com/definition/english/binge_1",
        "https://www.oxfordlearnersdictionaries.com/definition/english/binge_2"
      ],
      "canonicalId": 2009178,
      "canonicalSourceSha256": "e97d6e85b691c68f2fe88b64ea7975469bea244ae43a2414ce296bcf6c0ebd3f"
    },
    {
      "term": "spree",
      "partOfSpeech": "noun",
      "meaning": "① 一阵尽兴、往往过量的活动，常与 shopping 等连用，表示一阵放纵式的购物等行为。\n② 报刊用语：一连串、短时间内集中发生的某类活动，可用于犯罪或比赛得分等，不一定带有愉快的含义。",
      "chineseAliases": [
        "一阵放纵的活动",
        "疯狂购物"
      ],
      "englishForms": [
        "sprees"
      ],
      "en": "A shopping spree left him with too many bags.",
      "zh": "一阵疯狂购物让他提了太多袋子。",
      "references": [
        "https://www.oxfordlearnersdictionaries.com/definition/english/spree"
      ],
      "canonicalId": 1970346,
      "canonicalSourceSha256": "ebf742cfd5277757ba5781b32ea33efaaf3b6ac86879a8ae50a0949760ab2b85"
    },
    {
      "term": "funky",
      "partOfSpeech": "adjective",
      "meaning": "① 新潮别致的；不循常规而时髦的，表示赞许。\n② 外观或感觉古怪、奇特的，可作较中性的描述，不自动等于赞美其时髦。\n③ 音乐有放克等风格、具有相应鲜明节奏或感觉的。\n④ 美式用法：有难闻气味的；发臭的。\n⑤ 惊慌的；害怕的，是与风格、音乐和气味义分开的用法。",
      "chineseAliases": [
        "新潮别致的",
        "古怪奇特的"
      ],
      "englishForms": [
        "funkier",
        "funkiest"
      ],
      "en": "Funky lamps brightened the otherwise plain reception area.",
      "zh": "新潮别致的灯具让原本朴素的接待区亮眼起来。",
      "references": [
        "https://www.oxfordlearnersdictionaries.com/definition/english/funky",
        "https://www.merriam-webster.com/dictionary/funky"
      ],
      "canonicalId": 1953826,
      "canonicalSourceSha256": "67e10ceaa8018e0c48c21efa3aeffd0832b593378830908763e70c74d5a55427"
    },
    {
      "term": "nutty",
      "partOfSpeech": "adjective",
      "meaning": "① 有坚果味的，描述味道，本身不证明食物实际含有坚果。\n② 含坚果的，描述成分，与仅有坚果风味分开判断。\n③ 非正式用语：有点古怪的；傻乎乎的。\n④ 非正式用语：非常喜欢、迷恋某人或某物，常用 nutty about somebody or something。",
      "chineseAliases": [
        "有坚果味的",
        "含坚果的"
      ],
      "englishForms": [],
      "en": "The bread had a pleasantly nutty flavor.",
      "zh": "面包带着宜人的坚果味。",
      "references": [
        "https://www.oxfordlearnersdictionaries.com/definition/english/nutty"
      ],
      "canonicalId": 1965975,
      "canonicalSourceSha256": "86c35b1c72b6c565048abb1201214b64db1bf21cd8099005c749dd0f3e92b621"
    },
    {
      "term": "orchestrate",
      "partOfSpeech": "verb",
      "meaning": "① 精心安排、协调复杂的计划或活动，使各部分配合起来；可以暗中安排，但不必然含有秘密或负面含义。\n② 将乐曲编配为管弦乐；为管弦乐队安排各声部。",
      "chineseAliases": [
        "精心安排",
        "协调策划"
      ],
      "englishForms": [
        "orchestrated",
        "orchestrates",
        "orchestrating"
      ],
      "en": "She orchestrated a surprise reunion for the retiring conductor.",
      "zh": "她为即将退休的指挥精心安排了一次惊喜重聚。",
      "references": [
        "https://www.oxfordlearnersdictionaries.com/definition/english/orchestrate"
      ],
      "canonicalId": 1909091,
      "canonicalSourceSha256": "643b83680953c268de9be5565ecfd2f3c5893c22ea419d303f0034f4c4784f54"
    },
    {
      "term": "showcase",
      "partOfSpeech": "noun · verb",
      "meaning": "① 名词：展示才华、优点或成果的机会、活动或平台，常用 a showcase for something。\n② 名词：玻璃陈列柜；用来展示物品的柜子。\n③ 及物动词：展示；使某人或某物的能力、优点或良好品质得到充分呈现。",
      "chineseAliases": [
        "展示平台",
        "展示才华"
      ],
      "englishForms": [
        "showcased",
        "showcases",
        "showcasing"
      ],
      "en": "The festival provides a showcase for local ceramic artists.",
      "zh": "这个节庆为本地陶艺家提供了展示平台。",
      "references": [
        "https://www.oxfordlearnersdictionaries.com/definition/english/showcase_1",
        "https://www.oxfordlearnersdictionaries.com/definition/english/showcase_2"
      ],
      "canonicalId": 1875728,
      "canonicalSourceSha256": "c0d00239d41657c61c39a1ed43ff342c7148f64d07fd9f2ebae8833d584109d8"
    }
  ]
}
