{
  "schemaVersion": 1,
  "id": "chinese-related-003",
  "start": 55,
  "groups": [
    { "number": 55, "terms": ["勤奋", "勤劳", "勤勉"], "heads": ["diligent", "industrious", "assiduous", "diligence"], "forbidden": ["lazy", "industry"], "note": "diligence 是名词；assiduous 较书面，不与形容词直接互换。" },
    { "number": 56, "terms": ["懒惰", "懒散", "怠惰"], "heads": ["lazy", "idle", "indolent", "slothful"], "forbidden": ["sleepy", "leisure"], "note": "懒惰不等于困倦或有空闲；indolent、slothful 较书面。" },
    { "number": 57, "terms": ["富裕", "富有", "富足"], "heads": ["rich", "wealthy", "affluent", "well-to-do"], "forbidden": ["poor", "plenty"], "note": "本组侧重经济宽裕；不因某物数量充足就判断为人的富裕。" },
    { "number": 58, "terms": ["贫穷", "贫困", "穷困"], "heads": ["poor", "poverty", "needy", "destitute"], "forbidden": ["wealthy", "need"], "note": "poverty 是名词；destitute 表示极度贫困，程度强于 poor。" },
    { "number": 59, "terms": ["谦虚", "谦逊"], "heads": ["modest", "humble", "unassuming", "humility"], "forbidden": ["condescending", "condescend"], "note": "humility 是名词；不把 condescending 的居高临下态度当成谦逊。" },
    { "number": 60, "terms": ["傲慢", "高傲", "倨傲"], "heads": ["arrogant", "haughty", "imperious", "hubris"], "forbidden": ["high", "grand"], "note": "haughty、imperious 语气较强；hubris 是表示过度自负的名词。" },
    { "number": 61, "terms": ["友好", "友善", "亲善"], "heads": ["friendly", "amicable", "affable", "goodwill"], "forbidden": ["neighbor", "hostile"], "note": "amicable 常形容关系或安排；affable 常形容人；goodwill 是名词。" },
    { "number": 62, "terms": ["残忍", "残酷", "凶残"], "heads": ["cruel", "brutal", "ruthless", "merciless"], "forbidden": ["grim", "kind"], "note": "brutal 偏野蛮，ruthless、merciless 偏无情；并非所有严峻情况都叫残忍。" },
    { "number": 63, "terms": ["冷静", "镇定", "沉着"], "heads": ["calm", "cool", "composed", "composure"], "forbidden": ["cold", "philosophy"], "note": "仅关联情绪和应对态度；cool 也有凉爽义；composure 是名词。" },
    { "number": 64, "terms": ["孤独", "孤单", "寂寞"], "heads": ["lonely", "lonesome", "solitary", "loneliness"], "forbidden": ["autistic", "single"], "note": "solitary 偏独处状态，lonely、lonesome 偏感到寂寞；不混入临床诊断或婚姻状态。" },
    { "number": 65, "terms": ["宽阔", "宽广", "广阔"], "heads": ["wide", "broad", "spacious", "expansive"], "forbidden": ["ocean", "liberality"], "note": "spacious 常形容空间宽敞；expansive 可形容范围广阔，不与所有宽度描述互换。" },
    { "number": 66, "terms": ["吵闹", "喧闹", "喧嚣"], "heads": ["noisy", "rowdy", "boisterous", "clamorous", "racket"], "forbidden": ["sound", "furious"], "note": "rowdy 偏人群不守秩序；boisterous 偏热闹活跃；racket 是喧闹声的名词。" },
    { "number": 67, "terms": ["必要", "必需"], "heads": ["necessary", "essential", "requisite", "necessity"], "forbidden": ["necessarily", "optional"], "note": "necessity 是名词；necessary、essential、requisite 不是所有场合都能直接互换。" },
    { "number": 68, "terms": ["等待", "等候"], "heads": ["wait", "await", "waiting"], "forbidden": ["W", "in store for"], "note": "wait 常接 for；await 直接接宾语；此处保留 waiting 的名词／形容词释义。" },
    { "number": 69, "terms": ["到达", "抵达"], "heads": ["arrive", "reach", "arrival"], "forbidden": ["fetch", "accession"], "note": "arrive 常接 at 或 in；reach 直接接地点；arrival 是名词。" },
    { "number": 70, "terms": ["选择", "挑选", "选取"], "heads": ["choose", "select", "pick", "choice", "selection"], "forbidden": ["pack", "discretionary"], "note": "choose、select、pick 是动词用法；choice、selection 是相关名词，保留词性区别。" },
    { "number": 71, "terms": ["创建", "建立", "创立"], "heads": ["establish", "found", "institute", "set up"], "forbidden": ["promotion", "birth"], "note": "侧重建立机构或制度；found 在此是创立的原形，不是 find 的过去式。" },
    { "number": 72, "terms": ["保护", "防护", "保卫"], "heads": ["protect", "defend", "guard", "protection"], "forbidden": ["father", "ensure"], "note": "protect 偏免受伤害，defend 偏抵御攻击，guard 偏警戒；protection 是名词。" },
    { "number": 73, "terms": ["阻止", "阻拦", "制止"], "heads": ["prevent", "stop", "restrain", "deter"], "forbidden": ["keep", "arrest"], "note": "常用 prevent somebody from doing；restrain 偏约束，deter 偏使人打消念头。" },
    { "number": 74, "terms": ["改善", "改进", "改良"], "heads": ["improve", "amend", "ameliorate", "improvement"], "forbidden": ["evolutionary", "worsen"], "note": "amend 常用于修改文本或制度；ameliorate 较正式；improvement 是名词。" },
    { "number": 75, "terms": ["解释", "说明", "阐释"], "heads": ["explain", "interpret", "explanation"], "forbidden": ["instruction", "direction"], "note": "interpret 也可表示口译或诠释；explanation 是名词；不混入操作指令。" },
    { "number": 76, "terms": ["隐藏", "隐蔽", "藏匿"], "heads": ["hide", "conceal", "harbour", "covert"], "forbidden": ["latent", "private"], "note": "harbour 的藏匿义多指窝藏、庇护某人；covert 是形容词，不是 hide 的直接动词替换。" },
    { "number": 77, "terms": ["称赞", "赞扬", "赞美"], "heads": ["praise", "compliment", "applaud", "laud"], "forbidden": ["blame", "magnify"], "note": "compliment 常表示对人的夸赞，applaud 也指鼓掌，laud 较正式。" },
    { "number": 78, "terms": ["责备", "责怪", "指责"], "heads": ["blame", "reproach", "rebuke", "censure"], "forbidden": ["reflect", "damn"], "note": "blame 偏归责；rebuke、censure 较正式，语气和搭配不完全相同。" },
    { "number": 79, "terms": ["道歉", "致歉"], "heads": ["apologize", "apologise", "apology", "apologetic"], "forbidden": ["excuse", "amende"], "note": "apologise 是常见英式拼写；apology 是名词，apologetic 是形容词。" },
    { "number": 80, "terms": ["欺骗", "蒙骗", "哄骗"], "heads": ["deceive", "cheat", "trick", "hoodwink"], "forbidden": ["job", "mock"], "note": "cheat 常涉及不诚实获利；trick 偏用计；hoodwink 偏蒙骗，语域不同。" },
    { "number": 81, "terms": ["继续", "持续", "延续"], "heads": ["continue", "last", "endure", "sustain"], "forbidden": ["succeed", "renew"], "note": "last 常指时间上持续，endure 较正式，sustain 常需宾语；不可忽略各自句型。" },
    { "number": 82, "terms": ["停止", "停下", "停住"], "heads": ["stop", "cease", "halt", "quit"], "forbidden": ["rest", "stick"], "note": "cease 较正式；halt 常指进程中止；quit 常指停止某项活动或离开。" },
    { "number": 83, "terms": ["增加", "增多", "增长"], "heads": ["increase", "grow", "rise", "growth"], "forbidden": ["improve", "jack"], "note": "侧重数量或规模变大；rise 通常不及物；growth 是名词，不混同质量改善。" },
    { "number": 84, "terms": ["减少", "减小", "缩减"], "heads": ["reduce", "decrease", "lessen", "reduction"], "forbidden": ["red", "dull"], "note": "数量、尺寸或程度的减小需结合宾语；reduction 是名词，不与动词直接互换。" }
  ]
}
