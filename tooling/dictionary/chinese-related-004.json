{
  "schemaVersion": 1,
  "id": "chinese-related-004",
  "start": 85,
  "groups": [
    { "number": 85, "terms": ["诚实", "正直"], "heads": ["honest", "truthful", "upright", "honesty"], "forbidden": ["dishonest", "truth"], "note": "truthful 侧重说真话，upright 侧重品行正直；honesty 是名词，不与形容词直接互换。" },
    { "number": 86, "terms": ["忠诚", "忠实", "忠贞"], "heads": ["loyal", "faithful", "loyalty"], "forbidden": ["traitor", "dishonest"], "note": "loyal、faithful 是形容词；loyalty 是名词；faithful 也可指忠于原作。" },
    { "number": 87, "terms": ["耐心", "耐性", "有耐心"], "heads": ["patient", "patience", "patiently"], "forbidden": ["doctor", "idle"], "note": "patient 在此取有耐心的形容词义，不是病人；patience 是名词，patiently 是副词，保留词性区别。" },
    { "number": 88, "terms": ["好奇", "好奇心"], "heads": ["curious", "curiosity"], "forbidden": ["strange", "knowledge"], "note": "curious 是形容词，curiosity 是名词；这里只关联求知的意思，不把奇怪义混为同义。" },
    { "number": 89, "terms": ["乐观", "乐天"], "heads": ["optimistic", "optimism"], "forbidden": ["pessimistic", "hope"], "note": "optimistic 是形容词，optimism 是名词；有某个希望不必然表示总体态度乐观。" },
    { "number": 90, "terms": ["悲观", "悲观情绪"], "heads": ["pessimistic", "gloomy", "pessimism"], "forbidden": ["optimistic", "sad"], "note": "pessimism 是名词；gloomy 在此取前景悲观义，不把所有悲伤或阴暗都当成悲观。" },
    { "number": 91, "terms": ["热情", "热忱", "热心"], "heads": ["enthusiastic", "enthusiasm", "ardent", "zeal"], "forbidden": ["fever", "temperature"], "note": "enthusiastic、ardent 是形容词；enthusiasm、zeal 是名词；这里只指态度热心，不指温度。" },
    { "number": 92, "terms": ["冷漠", "冷淡"], "heads": ["cold", "aloof", "chilly", "unemotional"], "forbidden": ["weather", "temperature"], "note": "cold、chilly 在此取待人冷淡义，aloof 偏疏远，unemotional 偏不显露感情；不混同天气寒冷。" },
    { "number": 93, "terms": ["自信", "信心"], "heads": ["confident", "assured", "confidence", "self-confident"], "forbidden": ["arrogant", "bold"], "note": "confidence 是名词，其余为形容词；自信不等于傲慢，也不等于一切大胆行为。" },
    { "number": 94, "terms": ["紧张", "不安"], "heads": ["nervous", "tense", "tension"], "forbidden": ["nerve", "neurology"], "note": "nervous、tense 的情绪义是形容词，tension 的紧张义是名词；不把神经科学术语混入。" },
    { "number": 95, "terms": ["尴尬", "窘迫", "困窘"], "heads": ["embarrassed", "abashed", "awkwardness"], "forbidden": ["humiliate", "clumsy"], "note": "embarrassed、abashed 描写人的窘态；awkwardness 是名词；不等于使人蒙羞或动作笨拙。" },
    { "number": 96, "terms": ["沮丧", "灰心"], "heads": ["dejected", "downhearted"], "forbidden": ["depress", "despair"], "note": "两词都是描写情绪低落的形容词；不混入使人沮丧的动词，也不直接提升为绝望或临床诊断。" },
    { "number": 97, "terms": ["满意", "满足"], "heads": ["content", "contented", "satisfaction"], "forbidden": ["container", "contain"], "note": "content、contented 在此取满足的形容词义；satisfaction 是名词；content 的内容义另有用法和重音。" },
    { "number": 98, "terms": ["感激", "感谢"], "heads": ["grateful", "thankful", "thank", "appreciation"], "forbidden": ["thankless", "pleasant"], "note": "grateful、thankful 是形容词，thank 常用作动词，appreciation 是名词；各自句型不同。" },
    { "number": 99, "terms": ["尊重", "尊敬", "敬重"], "heads": ["respect", "esteem", "revere"], "forbidden": ["respectful", "respectable"], "note": "respect、esteem 可作名词或动词；revere 是动词，敬仰程度较强；不混入值得尊敬等派生形容词。" },
    { "number": 100, "terms": ["信任", "信赖"], "heads": ["trust", "rely", "reliance", "confidence"], "forbidden": ["trustee", "trustworthy"], "note": "rely 常接 on，reliance、confidence 是名词；confidence in 可表示对某人的信任；不把受托人当成信任。" },
    { "number": 101, "terms": ["鼓励", "激励", "勉励"], "heads": ["encourage", "encouragement", "hearten"], "forbidden": ["courage", "incite"], "note": "encouragement 是名词；encourage 常接 somebody to do；hearten 偏使人振作，不泛化为煽动。" },
    { "number": 102, "terms": ["支持", "拥护"], "heads": ["support", "endorse", "uphold", "espouse"], "forbidden": ["supporter", "pillar"], "note": "endorse 常表示公开支持，uphold 常接决定或原则，espouse 常接主张；不把支持者或柱子当成支持行为。" },
    { "number": 103, "terms": ["合作", "协作"], "heads": ["cooperate", "collaborate", "cooperation", "collaborative"], "forbidden": ["collaborator", "coordinate"], "note": "cooperate、collaborate 是动词，cooperation 是名词，collaborative 是形容词；保留各自词性。" },
    { "number": 104, "terms": ["竞争", "角逐"], "heads": ["compete", "contend", "competition", "vie"], "forbidden": ["competitor", "opponent"], "note": "competition 是名词；compete、contend、vie 是动词，常需 with、for 等搭配；不把对手混作竞争行为。" },
    { "number": 105, "terms": ["接受", "接纳"], "heads": ["accept", "acceptance"], "forbidden": ["receive", "admissible"], "note": "accept 是动词，acceptance 是名词；愿意接受不同于仅仅收到某物，也不等于所有准入许可。" },
    { "number": 106, "terms": ["否认", "否定"], "heads": ["deny", "disavow", "denial", "negate"], "forbidden": ["refute", "disprove"], "note": "denial 是名词；disavow 偏正式否认责任或关系；否认一项说法不等于已经以证据驳倒它。" },
    { "number": 107, "terms": ["建议", "提议"], "heads": ["suggest", "advise", "propose", "suggestion", "advice"], "forbidden": ["command", "order"], "note": "suggestion 是可数名词，advice 通常不可数；advise 常接 somebody to do，suggest 可接 doing，不是命令。" },
    { "number": 108, "terms": ["邀请", "邀约"], "heads": ["invite", "invitation"], "forbidden": ["summon", "visitor"], "note": "invite 是动词，常接 somebody to do；invitation 是名词；邀请不等于命令某人到场。" },
    { "number": 109, "terms": ["通知", "告知"], "heads": ["notify", "inform", "notice"], "forbidden": ["remember", "memory"], "note": "notify、inform 是动词，常接 somebody of / about something；notice 在此保留通知的名词义。" },
    { "number": 110, "terms": ["警告", "告诫", "警示"], "heads": ["warn", "warning", "caution", "admonish"], "forbidden": ["menace", "alert"], "note": "warning 是名词，caution 可作名词或动词，admonish 偏正式告诫；警告不等于发出威胁。" },
    { "number": 111, "terms": ["原谅", "宽恕"], "heads": ["forgive", "pardon", "forgiveness"], "forbidden": ["forgiving", "punish"], "note": "forgiveness 是名词；常用 forgive somebody for something；pardon 也有法律上的赦免义。" },
    { "number": 112, "terms": ["承诺", "许诺", "允诺", "诺言"], "heads": ["promise", "pledge"], "forbidden": ["promising", "forecast"], "note": "promise、pledge 均可作名词或动词；pledge 偏郑重承诺，promise to do 常见；不把前途有望当成承诺。" },
    { "number": 113, "terms": ["计划", "打算"], "heads": ["plan", "intend", "scheme", "propose"], "forbidden": ["planner", "diagram"], "note": "intend 常接 to do；scheme 可能表示阴谋，也可指方案；plan 可作名词或动词，需结合语境。" },
    { "number": 114, "terms": ["怀疑", "疑惑"], "heads": ["doubt", "suspect", "doubtful", "skeptical", "sceptical"], "forbidden": ["certainty", "prisoner"], "note": "doubt 偏不确信，suspect 偏猜想某事不妥或怀疑某人；skeptical、sceptical 是持怀疑态度的形容词，为美英常见拼写；doubtful 也是形容词。" }
  ]
}
