      "references": [
        "https://housing.berkeley.edu/resident-resources/what-to-know-about-your-building/maintenance-requests-custodial-and-cleaning/"
      ]
    },
    {
      "term": "emergency repair",
      "partOfSpeech": "noun phrase",
      "meaning": "① 紧急维修；为处理迫切的安全风险或严重损坏而需要尽快进行的修理。具体服务认定因机构而异。",
      "chineseAliases": [
        "紧急维修",
        "应急维修"
      ],
      "englishForms": [
        "emergency repairs"
      ],
