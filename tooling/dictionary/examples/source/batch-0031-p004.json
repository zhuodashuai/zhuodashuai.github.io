  "entries": [
    {
      "term": "factorable",
      "partOfSpeech": "adjective",
      "meaningZh": "可分解因子的",
      "en": "Because x² − 5x + 6 is factorable over the integers, she wrote it as (x − 2)(x − 3).",
      "zh": "因为x² − 5x + 6在整数范围内可作因式分解，她把它写成了(x − 2)(x − 3)。"
    },
    {
      "term": "unseeded",
      "partOfSpeech": "adjective",
      "meaningZh": "未加晶种的",
      "en": "The team left one crystallization run unseeded so that it could compare it with a seeded run.",
      "zh": "研究团队让一次结晶实验不加晶种，以便将它与一次加过晶种的实验比较。"
    },
    {
      "term": "hold-up",
      "partOfSpeech": "noun",
      "meaningZh": "滞留量",
      "en": "The operators compared the liquid hold-up in the two packed columns before increasing the flow.",
      "zh": "操作人员在增加流量前，比较了两座填料塔中的液体滞留量。"
    },
    {
      "term": "cabana",
      "partOfSpeech": "noun",
      "meaningZh": "小屋",
      "en": "We left our towels in the wooden cabana beside the pool before going for a swim.",
      "zh": "我们去游泳前，把毛巾留在泳池旁的木制小屋里。"
    },
    {
      "term": "lassie",
      "partOfSpeech": "noun",
      "meaningZh": "姑娘",
      "en": "“Come back, lassie!” the old Scottish ferryman called as she ran toward the pier.",
      "zh": "那个苏格兰老船夫见她朝码头跑去，喊道：“姑娘，回来！”"
    },
    {
      "term": "handicapper",
      "partOfSpeech": "noun",
      "meaningZh": "主管 handicap 的裁判人员",
      "en": "The handicapper assigned extra weight to the winning horse before its next race.",
      "zh": "在那匹获胜的马参加下一场比赛前，负责让步赛的裁判员给它增加了负重。"
    },
    {
      "term": "commissar",
      "partOfSpeech": "noun",
      "meaningZh": "人民委员",
      "en": "In the historical novel, the commissar for agriculture refuses to sign the grain-allocation order.",
      "zh": "在那部历史小说中，农业人民委员拒绝签署粮食调拨令。"
    },
    {
      "term": "flapper",
      "partOfSpeech": "noun",
      "meaningZh": "苍蝇拍",
      "en": "The stable boy waved a leather flapper to keep the flies off the mare.",
      "zh": "马童挥动皮制苍蝇拍，免得苍蝇落到母马身上。"
    },
    {
      "term": "mor",
      "partOfSpeech": "noun",
      "meaningZh": "粗腐殖质",
      "en": "The soil scientist measured the depth of the mor beneath the old spruce trees.",
      "zh": "土壤学家测量了老云杉树下粗腐殖质的厚度。"
    },
    {
      "term": "outguess",
      "partOfSpeech": "verb",
      "meaningZh": "看透",
      "en": "She managed to outguess her chess opponent and save the rook.",
      "zh": "她成功看透了国际象棋对手的意图，保住了那枚车。"
    },
    {
      "term": "unmodulated",
      "partOfSpeech": "adjective",
      "meaningZh": "未调制的",
      "en": "The receiver picked up an unmodulated carrier but no speech.",
      "zh": "接收机收到了未调制的载波，却没有收到语音。"
    },
    {
      "term": "specifier",
      "partOfSpeech": "noun",
      "meaningZh": "说明符",
      "en": "The format specifier %d prints the counter as an integer.",
      "zh": "格式说明符%d把计数器按整数格式输出。"
    },
    {
      "term": "uremic",
      "partOfSpeech": "adjective",
      "meaningZh": "尿毒症的",
      "en": "Her report distinguishes uremic symptoms from the patient's unrelated ankle injury.",
      "zh": "她的报告把尿毒症症状和患者与之无关的脚踝损伤区分开来。"
    },
    {
      "term": "tiddly",
      "partOfSpeech": "adjective",
      "meaningZh": "很小的",
      "en": "All six of us were squeezed into a tiddly office above the bakery.",
      "zh": "我们六个人全挤在面包店楼上一间很小的办公室里。"
    },
    {
      "term": "viceroyalty",
      "partOfSpeech": "noun",
      "meaningZh": "总督之位",
      "en": "He refused the viceroyalty because accepting it would mean leaving his family behind.",
      "zh": "他拒绝了总督之位，因为接受任命就意味着要离开家人。"
    },
    {
      "term": "sloe",
      "partOfSpeech": "noun",
      "meaningZh": "黑刺李",
      "en": "A ripe sloe dropped into her basket as she shook the blackthorn branch.",
      "zh": "她摇动黑刺李的枝条时，一颗成熟的黑刺李果掉进了篮子。"
    },
    {
      "term": "allografting",
      "partOfSpeech": "noun",
      "meaningZh": "异体移植(术)",
      "en": "Her thesis compares the costs of allografting with those of using a patient's own tissue.",
      "zh": "她的论文比较了异体移植与使用患者自身组织的费用。"
    },
    {
      "term": "alloantigen",
      "partOfSpeech": "noun",
      "meaningZh": "同种抗原",
      "en": "The study tested whether the antibody recognized a particular alloantigen.",
      "zh": "那项研究检验了该抗体是否识别某一种同种抗原。"
    },
    {
      "term": "allotype",
      "partOfSpeech": "noun",
      "meaningZh": "(同种)异型",
      "en": "The two antibody samples differed in allotype, although they belonged to the same class.",
      "zh": "这两份抗体样本的同种异型不同，尽管它们属于同一类别。"
    },
    {
      "term": "amyl nitrate",
      "partOfSpeech": "noun",
      "meaningZh": "硝酸戊酯",
      "en": "On the inventory sheet, amyl nitrate and amyl nitrite appear as separate substances.",
      "zh": "在库存清单上，硝酸戊酯和亚硝酸戊酯被列为两种不同的物质。"
    },
    {
      "term": "allyl alcohol",
      "partOfSpeech": "noun",
      "meaningZh": "烯丙醇",
      "en": "The technician moved the bottle of allyl alcohol away from the edge of the bench.",
      "zh": "技术员把那瓶烯丙醇从实验台边缘移开了。"
    },
    {
      "term": "brachial plexus",
      "partOfSpeech": "noun",
      "meaningZh": "臂丛",
      "en": "The tutor asked us to locate the brachial plexus between the neck and the shoulder on the model.",
      "zh": "导师让我们在模型上找出颈部与肩部之间的臂丛。"
    },
    {
      "term": "brand-name drug",
      "partOfSpeech": "noun",
      "meaningZh": "原厂药",
      "en": "She asked whether the pharmacy stocked the brand-name drug or only its generic equivalent.",
      "zh": "她问药房是否备有那种原厂药，还是只有相应的仿制药。"
    },
    {
      "term": "can buoy",
      "partOfSpeech": "noun",
      "meaningZh": "罐形浮标",
      "en": "Fog hid the shoreline, but we could still make out a can buoy beside the channel.",
      "zh": "雾遮住了岸线，但我们仍能辨认出航道旁的一座罐形浮标。"
    },
    {
      "term": "canary seed",
      "partOfSpeech": "noun",
      "meaningZh": "金丝雀草籽",
      "en": "The farmer set aside a sack of canary seed for planting, not for the mixed bird feed.",
      "zh": "农民留出了一袋金丝雀草籽用于播种，而不是用于混合鸟食。"
    },
    {
      "term": "bus depot",
      "partOfSpeech": "noun",
      "meaningZh": "公共汽车停车场",
      "en": "The last driver left the empty bus at the bus depot and handed in the keys.",
      "zh": "最后一名司机把空车停在公共汽车停车场，并交还了钥匙。"
    },
    {
      "term": "booster station",
      "partOfSpeech": "noun",
      "meaningZh": "接力站",
      "en": "When the booster station on the hill lost power, the village's radio reception failed.",
      "zh": "山上的接力站断电时，村里的收音机收不到信号了。"
    },
    {
      "term": "brace up",
      "partOfSpeech": "verb",
      "meaningZh": "打起精神",
      "en": "“Brace up,” said the coach. “You still have one race left.”",
      "zh": "教练说：“打起精神来，你还有一场比赛呢。”"
    },
    {
      "term": "bissextile year",
      "partOfSpeech": "noun",
      "meaningZh": "闰年",
      "en": "Because it was a bissextile year, the diary had an extra page for 29 February.",
      "zh": "因为那年是闰年，日记本为2月29日多留了一页。"
    },
    {
      "term": "limit point",
      "partOfSpeech": "noun",
      "meaningZh": "极限点",
      "en": "Every open interval around zero contains nonzero points of this set, so zero is a limit point.",
      "zh": "零的每个开区间邻域都包含这个集合中的非零点，因此零是一个极限点。"
    },
    {
      "term": "yod",
      "partOfSpeech": "noun",
      "meaningZh": "希伯来文第十个字母",
      "en": "In her Hebrew lettering exercise, she made the yod too large.",
      "zh": "在希伯来文字母书写练习中，她把第十个字母写得太大了。"
    },
    {
      "term": "airlight",
      "partOfSpeech": "noun",
      "meaningZh": "空气光",
      "en": "Her image model estimated the airlight before recovering the mountain's colors.",
      "zh": "她的图像模型先估计空气光，再恢复山体的颜色。"
    },
    {
      "term": "amazonstone",
      "partOfSpeech": "noun",
      "meaningZh": "天河石",
      "en": "She chose an amazonstone pendant because its green color matched her scarf.",
      "zh": "她选了一枚天河石吊坠，因为它的绿色与她的围巾相配。"
    },
    {
      "term": "light machine gun",
      "partOfSpeech": "noun",
      "meaningZh": "轻机枪",
      "en": "The exhibition paired a light machine gun with photographs of the infantry unit that used it.",
      "zh": "展览把一挺轻机枪与使用过它的步兵部队的照片放在一起展示。"
    },
    {
      "term": "keep in",
      "partOfSpeech": "verb",
      "meaningZh": "抑制",
      "en": "It was hard to keep in my laughter when the solemn judge sneezed.",
      "zh": "那位严肃的法官打喷嚏时，我很难忍住笑。"
    },
    {
      "term": "lie with",
      "partOfSpeech": "verb",
      "meaningZh": "是...的权利/义务",
      "en": "The final decision will lie with the editor, not the publisher.",
      "zh": "最终决定权属于编辑，而不是出版商。"
    },
    {
      "term": "cart away",
      "partOfSpeech": "verb",
      "meaningZh": "强行带走",
      "en": "The guards threatened to cart away anyone who blocked the palace gate.",
      "zh": "卫兵威胁要强行带走任何堵住宫门的人。"
    },
    {
      "term": "bring through",
      "partOfSpeech": "verb",
      "meaningZh": "救活",
      "en": "The doctors worked through the night to bring the child through.",
      "zh": "医生们彻夜工作，想把那个孩子救活。"
    },
    {
      "term": "bear off",
      "partOfSpeech": "verb",
      "meaningZh": "驶离",
      "en": "Seeing the ferry ahead, the helmsman decided to bear off to starboard.",
      "zh": "看到前方的渡船，舵手决定向右驶离。"
    },
    {
      "term": "belt down",
      "partOfSpeech": "verb",
      "meaningZh": "朝…方向急走；飞奔",
      "en": "She had to belt down the hill to catch the last bus.",
      "zh": "她得飞奔下山，才能赶上末班公交车。"
    },
    {
      "term": "ring out",
      "partOfSpeech": "verb",
      "meaningZh": "鸣钟送别",
      "en": "The villagers gathered to ring out the old year at midnight.",
      "zh": "午夜，村民们聚在一起鸣钟辞旧岁。"
    },
    {
      "term": "crack up",
      "partOfSpeech": "verb",
      "meaningZh": "撞坏",
      "en": "We took the keys away before he could crack up another car.",
      "zh": "我们拿走了钥匙，免得他再把一辆车撞坏。"
    },
    {
      "term": "string along",
      "partOfSpeech": "verb",
      "meaningZh": "欺骗",
      "en": "The landlord tried to string along the tenants with promises of repairs he never intended to make.",
      "zh": "房东想用自己根本不打算兑现的维修承诺来欺骗租客。"
    },
    {
      "term": "numbers game",
      "partOfSpeech": "noun",
      "meaningZh": "（通常为误导他人的）数字游戏",
      "en": "By changing the reporting dates, the company turned its sales figures into a misleading numbers game.",
      "zh": "通过更改报告日期，公司把销售数字变成了一场误导人的数字游戏。"
    },
    {
      "term": "braless",
      "partOfSpeech": "adjective",
      "meaningZh": "不戴胸罩的",
      "en": "She wore a loose sweatshirt and went braless while recovering at home.",
      "zh": "她在家休养时穿着宽松的运动衫，没有戴胸罩。"
    },
    {
      "term": "allod",
      "partOfSpeech": "noun",
      "meaningZh": "保有绝对所有权的土地",
      "en": "The medieval charter describes the farm as an allod, not a fief held from a lord.",
      "zh": "那份中世纪特许状把农场记为保有绝对所有权的土地，而不是领自主君的封地。"
    },
    {
      "term": "allodium",
      "partOfSpeech": "noun",
      "meaningZh": "自主地产",
      "en": "In the historian's reconstruction, a stream marked the edge of the family's allodium.",
      "zh": "在那位历史学家的复原叙述中，一条小溪标出了那家人的自主地产的边界。"
    },
    {
      "term": "allosome",
      "partOfSpeech": "noun",
      "meaningZh": "异染色体",
      "en": "The geneticist separated the allosome data from the autosome data before comparing the samples.",
      "zh": "比较样本前，遗传学家把异染色体的数据与常染色体的数据分开了。"
    },
    {
      "term": "alloimmunity",
      "partOfSpeech": "noun",
      "meaningZh": "同种免疫",
      "en": "Alloimmunity became the central topic when the seminar turned from infections to transplantation.",
      "zh": "当研讨课从感染转向移植时，同种免疫成了中心话题。"
    }
  ],
