  "authorPrincipal": "d31_author_root_p005",
  "entries": [
    {
      "term": "nanette",
      "partOfSpeech": "noun",
      "meaningZh": "纳内特",
      "en": "Nanette checked the booking confirmation and realised she had chosen the wrong weekend.",
      "zh": "纳内特查看预订确认信息，才意识到自己选错了周末。"
    },
    {
      "term": "aron",
      "partOfSpeech": "noun",
      "meaningZh": "阿伦",
      "en": "Aron lowered the shelf slightly so that his son could reach the books without standing on a chair.",
      "zh": "阿伦把架子稍微调低了些，让儿子不用站在椅子上也能够到书。"
    },
    {
      "term": "marsha",
      "partOfSpeech": "noun",
      "meaningZh": "玛莎",
      "en": "Before restarting the printer, Marsha removed the sheet of paper trapped beneath the roller.",
      "zh": "重启打印机之前，玛莎取出了卡在滚筒下面的那张纸。"
    },
    {
      "term": "elly",
      "partOfSpeech": "noun",
      "meaningZh": "艾莉",
      "en": "Elly slipped a piece of cardboard behind the photograph to stop it bending in the post.",
      "zh": "艾莉在照片后面垫了一块硬纸板，以免照片在邮寄途中弯折。"
    },
    {
      "term": "debra",
      "partOfSpeech": "noun",
      "meaningZh": "黛布拉",
      "en": "Debra moved the chopping board away from the edge of the counter before letting the children help with lunch.",
      "zh": "让孩子们帮忙准备午餐之前，黛布拉先把砧板从料理台边缘往里挪了挪。"
    },
    {
      "term": "zelda",
      "partOfSpeech": "noun",
      "meaningZh": "塞尔达",
      "en": "Zelda wrote down the bus stop's name because the sign was difficult to read from across the road.",
      "zh": "塞尔达记下了公交车站的名字，因为从马路对面很难看清站牌。"
    },
    {
      "term": "alta",
      "partOfSpeech": "noun",
      "meaningZh": "阿尔塔",
      "en": "Alta left a narrow gap between the curtains to let in the morning light.",
      "zh": "阿尔塔在窗帘之间留了一道窄缝，让晨光透进来。"
    },
    {
      "term": "ina",
      "partOfSpeech": "noun",
      "meaningZh": "艾娜",
      "en": "When the handle came loose, Ina stopped using the saucepan and set it aside for repair.",
      "zh": "锅柄松动后，艾娜就不再使用那口长柄锅，并把它放到一边等着修理。"
    },
    {
      "term": "nik",
      "partOfSpeech": "noun",
      "meaningZh": "尼克",
      "en": "Nik saved a copy of the form before submitting it, so he could check exactly what he had sent.",
      "zh": "尼克在提交表格之前保存了一份副本，以便核对自己具体提交了什么。"
    },
    {
      "term": "cornelia",
      "partOfSpeech": "noun",
      "meaningZh": "科妮莉亚",
      "en": "Cornelia marked the last page she had read with a scrap of blue paper.",
      "zh": "科妮莉亚用一小片蓝纸标记了自己上次读到的那一页。"
    },
    {
      "term": "yvette",
      "partOfSpeech": "noun",
      "meaningZh": "伊薇特",
      "en": "Yvette measured the gap beside her bed before ordering the narrow bedside table.",
      "zh": "伊薇特先量了床边的空隙，再订购那张窄床头柜。"
    },
    {
      "term": "lolita",
      "partOfSpeech": "noun",
      "meaningZh": "洛丽塔",
      "en": "Lolita took a photograph of the sign before leaving the unfamiliar station.",
      "zh": "离开那个不熟悉的车站前，洛丽塔给标牌拍了张照片。"
    },
    {
      "term": "hattie",
      "partOfSpeech": "noun",
      "meaningZh": "哈蒂",
      "en": "Hattie tried the key in both directions before realising it belonged to a different door.",
      "zh": "哈蒂试着往两个方向转动钥匙，才意识到这是另一扇门的钥匙。"
    },
    {
      "term": "nino",
      "partOfSpeech": "noun",
      "meaningZh": "尼诺",
      "en": "Nino paused the recording whenever he needed more time to copy an unfamiliar expression.",
      "zh": "每当需要更多时间抄下一个不熟悉的表达时，尼诺就会暂停录音。"
    },
    {
      "term": "charlene",
      "partOfSpeech": "noun",
      "meaningZh": "沙琳",
      "en": "Charlene moved her chair away from the radiator after noticing that the heat was drying the leather.",
      "zh": "沙琳发现热气正使皮革变干后，便把自己的椅子挪得离暖气片远了些。"
    },
    {
      "term": "christiana",
      "partOfSpeech": "noun",
      "meaningZh": "克里斯蒂安娜",
      "en": "Christiana put the returned parcel on a separate shelf so that nobody would send it out again by mistake.",
      "zh": "克里斯蒂安娜把退回的包裹放在单独的架子上，以免有人误把它再次寄出去。"
    },
    {
      "term": "lottie",
      "partOfSpeech": "noun",
      "meaningZh": "洛蒂",
      "en": "Lottie compared the two receipts and found that she had been charged twice for the same delivery.",
      "zh": "洛蒂对比两张收据后发现，同一次送货向她收取了两次费用。"
    },
    {
      "term": "orville",
      "partOfSpeech": "noun",
      "meaningZh": "奥维尔",
      "en": "Orville tightened the loose screw a little at a time, checking that the wooden handle did not split.",
      "zh": "奥维尔一点一点地拧紧那颗松动的螺丝，同时检查木柄有没有裂开。"
    },
    {
      "term": "aimee",
      "partOfSpeech": "noun",
      "meaningZh": "艾梅",
      "en": "Aimee left the wet umbrella open in the hallway rather than putting it straight into the cupboard.",
      "zh": "艾梅把湿雨伞撑开放在走廊里，没有马上收进柜子。"
    }
  ],
  "projectionOnly": true,
