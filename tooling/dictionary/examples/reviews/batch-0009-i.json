  "issues": [
    {
      "term": "drily",
      "blocking": false,
      "issue": "原中文“冷幽默地”不够自然，所选副词强调不露声色的幽默。",
      "resolution": "已调整所选释义及译文为不动声色地打趣，保留帐篷积水的原场景。"
    },
    {
      "term": "sweetie",
      "blocking": false,
      "issue": "原句以雨到达晾衣绳作为催人进屋的时间界点，情境表达较生硬。",
      "resolution": "已原创改成在衣服被雨淋透前唤人进屋，保留亲昵称呼用法并忠实重译。"
    },
    {
      "term": "buz",
      "blocking": false,
      "issue": "原稿明确缩写待核，且把 BUZ 当可直接更换的器件名，缺少可靠支持；不应仅凭缩写聚合站批准。",
      "resolution": "独立找到 broncolor 官方 Senso 英文手册 PDF 第17页（印刷19页）9.3，明确 buz 是 buzzer/ready tone 的设备标注，15页也列 buz 功能。已把所选义限为设备蜂鸣音缩写，并原创改为摄影师检查闪光设备 buz 设置的自然使用场景；不是定义句，也不把局部技术缩写宣称为普通英语单词。https://broncolor.swiss/assets/img/Operating_Manual_Senso_ENG.pdf"
    },
    {
      "term": "surfer",
      "blocking": false,
      "issue": "lone 指该情境中独自一人的冲浪者，原译“唯一的”容易误成绝对数量判断。",
      "resolution": "已译为独自一人的冲浪者，保留黎明与碎浪之外的原句细节。"
    },
    {
      "term": "coarsely",
      "blocking": false,
      "issue": "coarsely chopped 指切成较大块，不等于粗略操作或只切几下。",
      "resolution": "已修正所选释义并译为切成大块，消除原译无依据的动作次数。"
    },
    {
      "term": "desirability",
      "blocking": false,
      "issue": "原译向往程度把事物的可取性移到了居民的愿望强度。",
      "resolution": "已译为更安静街道对居民的吸引力，保留原句 survey measured 的对象。"
    },
    {
      "term": "spd",
      "blocking": false,
      "issue": "电工缩写的技术义需独立核对。",
      "resolution": "独立核对 IEC 官方 61643-12 页面，确认 SPD 指 surge protective device，原报告语境与电涌保护器义匹配，予以保留。https://webstore.iec.ch/en/publication/32531"
    },
    {
      "term": "lai",
      "blocking": false,
      "issue": "队列旧义为航空公司缩写，作者改用叶面积指数，需核实所选新义。",
      "resolution": "独立核对 NASA MODIS 官方产品页，确认 Leaf Area Index (LAI)，原地块测量记录语境准确，保留已纠正所选义。https://modis.gsfc.nasa.gov/data/dataprod/mod15.php/index.php"
    },
    {
      "term": "ncr",
      "blocking": false,
      "issue": "历史收银机品牌义需核对。",
      "resolution": "独立核对 Smithsonian National Museum of American History 官方馆藏说明，确认 National Cash Register/NCR 及黄铜收银机语境，原句为通用修复叙述不虚构具体历史事实。https://americanhistory.si.edu/collections/object/nmah_723181"
    },
    {
      "term": "svq",
