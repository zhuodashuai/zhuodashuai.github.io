  "issues": [
    {
      "term": "disinter",
      "blocking": false,
      "issue": "原标签含一般挖出与遗体发掘两层范围，句中明确指remains。",
      "resolution": "选义收窄为掘出遗骸。"
    },
    {
      "term": "recondite",
      "blocking": false,
      "issue": "原标签同时列深奥与鲜为人知，句中重点为语法问题深奥。",
      "resolution": "收窄为深奥难懂的。"
    },
    {
      "term": "extirpation",
      "blocking": false,
      "issue": "原标签以主动消灭或清除表述，植物在当地灭绝不必由人为清除导致。",
      "resolution": "采用准确生态学选义物种在某个地区的灭绝。"
    },
    {
      "term": "declamation",
      "blocking": false,
      "issue": "句中是对既有speech的朗诵，原标签还列演说另一表达。",
      "resolution": "单义收窄为慷慨激昂的朗诵。"
    },
    {
      "term": "undirected",
      "blocking": false,
      "issue": "自由游戏不等于毫无方向，句中所选是没有指导。",
      "resolution": "标签改为没有指导的。"
    },
    {
      "term": "goodby",
      "blocking": false,
      "issue": "直接引语未用引号，初学者可能误判该词的句法位置。",
      "resolution": "保留经作者核实的规范变体，用引号明确直接引语，中文同步。"
    },
    {
      "term": "munificence",
      "blocking": false,
      "issue": "原中文慷慨捐助资助了学生奖学金搭配不自然。",
      "resolution": "改为慷慨捐助为来自附近村庄的学生提供了奖学金。"
    },
    {
      "term": "aggrandize",
      "blocking": false,
      "issue": "原标签并列扩张权势及使显得伟大，句中明确宾语authority。",
      "resolution": "收窄为扩张权势。"
    },
    {
      "term": "voracity",
      "blocking": false,
      "issue": "原标签并列食欲和求知欲，例句采用阅读渴求的比喻义。",
      "resolution": "采用强烈的渴求这一单一比喻选义。"
    },
    {
      "term": "coarsen",
      "blocking": false,
      "issue": "原标签并列物理粗糙与语言态度粗俗，句中明确布面。",
      "resolution": "收窄为使变粗糙。"
    },
    {
      "term": "idolater",
      "blocking": false,
      "issue": "原标签并列宗教偶像崇拜与对人的过分崇拜。",
      "resolution": "采用过分崇拜某人的人，与作曲家崇拜者例句对应。"
    }
