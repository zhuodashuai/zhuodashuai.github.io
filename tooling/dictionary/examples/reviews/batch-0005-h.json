    },
    {
      "term": "gouge",
      "blocking": false,
      "issue": "The gloss only mentioned chiselling although the example describes deep scratches.",
      "resolution": "Added the scratching-out-a-deep-mark sense."
    },
    {
      "term": "complicity",
      "blocking": true,
      "issue": "Complicity takes participation in an activity rather than in the forged documents themselves.",
      "resolution": "Rewrote the complement as forging the documents and matched the Chinese."
    },
    {
      "term": "graft",
      "blocking": false,
      "issue": "The example refers to the physical graft rather than the act of grafting.",
      "resolution": "Selected graft junction or scion in the gloss."
    },
    {
      "term": "filibuster",
      "blocking": false,
      "issue": "The Chinese sentence awkwardly embedded an action phrase as a noun.",
      "resolution": "Used a clear noun gloss with an explanatory parenthesis and a natural description of delaying the vote."
    },
    {
      "term": "astray",
      "blocking": false,
      "issue": "The Chinese adverb gloss was an unnatural fragment.",
      "resolution": "Reworded it as going in the wrong direction or being led away from the proper course."
