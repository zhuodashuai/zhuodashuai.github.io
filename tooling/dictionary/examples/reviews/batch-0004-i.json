  "issues": [
    {
      "term": "contingency",
      "blocking": false,
      "issue": "Spare batteries cannot address every foreseeable contingency, so the original context overstated their scope.",
      "resolution": "Replaced the context with a budget allowing for contingencies such as equipment failure and supplied a matching translation."
    },
    {
      "term": "glide",
      "blocking": false,
      "issue": "The Chinese added an approximation absent from the English, and the absolute claim about preserving stillness was needlessly awkward.",
      "resolution": "Used swans gliding quietly across a still pond, with a faithful Chinese translation."
    },
    {
      "term": "awe",
      "blocking": false,
      "issue": "The Chinese adverb sequence was unnatural.",
      "resolution": "Recast the translation as watching silently while filled with awe."
    },
    {
      "term": "niece",
      "blocking": false,
      "issue": "The translation assigned authorship of the drawing to the niece, although the English only identified its subject as her puppy.",
      "resolution": "Translated the drawing's subject accurately without claiming who drew it."
    }
  ]
