  "issues": [
    {
      "term": "odds-on",
      "blocking": false,
      "issue": "中文“极被看好”搭配不自然。",
      "resolution": "改为“大受看好”，保持极高获胜预期与实际落败的对照。"
    },
    {
      "term": "pre-eminent",
      "blocking": false,
      "issue": "中文仅“领先”弱化了首屈一指的精选义。",
      "resolution": "译为“首屈一指的地位”，与所选义及英语一致。"
    },
    {
      "term": "self-contained",
      "blocking": false,
      "issue": "studio可指普通工作室，中文“独立配备齐全”不自然，未明确本例独立生活设施之义。",
      "resolution": "明确为studio flat，译为设施齐全、独立使用的单间公寓，精选义同步自然化。"
    },
    {
      "term": "self-image",
      "blocking": false,
      "issue": "challenged表示动摇而不必已经彻底改变。",
      "resolution": "中文改为“动摇了”，不把挑战自我形象过度译成已改变。"
