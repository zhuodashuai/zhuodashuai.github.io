{
  "name": "zhuodashuai-github-pages",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "test": "pnpm test:unit && pnpm test:api",
    "test:unit": "node --test vocab/tests/*.test.mjs tests/*.test.mjs",
    "test:api": "pnpm --dir wordbook-api test",
    "test:e2e": "playwright test",
    "test:security": "node scripts/scan-secrets.mjs",
    "test:live": "node --test tests/live/provider-contract.mjs",
    "test:vocab-data": "node --test vocab/tests/vocab-100.test.mjs",
    "report:vocab:init": "node scripts/generate-vocab-quality-report.mjs",
    "serve:e2e": "node tests/e2e/server.mjs",
    "migrate:vocab": "node scripts/migrate-owner-wordbook-v3.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "fake-indexeddb": "6.2.5",
    "lighthouse": "13.4.1"
  }
}
